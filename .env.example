# Codex Lector — OAuth Configuration
# Copy this file to .env and fill in your credentials.
#
# You only need to configure the providers you want to enable.
# Any provider left blank will not appear on the sign-in screen.

# JWT secret (change this to something random in production)
JWT_SECRET=codex-lector-change-me-in-production

# Public site URL (used for OAuth callbacks, RSS, sitemap, and OG tags — no trailing slash)
SITE_URL=http://localhost:3001

# Optional backend fallback URL if different in local/dev.
BASE_URL=http://localhost:3001

# Optional social share image for embeds.
# Use an absolute URL or site-relative path to a JPG, PNG, WEBP, or GIF.
# X/Twitter cards do not support SVG here.
SOCIAL_IMAGE_URL=/social-card.png

# Optional semantic search embeddings (used for "semantic passage" search).
# Supports OpenAI or Voyage. If neither key is set, semantic search stays disabled.
# If both keys are set, Voyage is preferred unless SEMANTIC_EMBED_PROVIDER=openai.
SEMANTIC_EMBED_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/embeddings
VOYAGE_API_KEY=
VOYAGE_API_URL=https://api.voyageai.com/v1/embeddings
# Leave model blank to use a provider-specific default:
# OpenAI -> text-embedding-3-small
# Voyage -> voyage-3.5-lite
SEMANTIC_SEARCH_EMBED_MODEL=
# OpenAI accepts 64-1536; Voyage supports 256, 512, 1024, 2048.
# If the value is incompatible with the chosen provider, the app will normalize it.
SEMANTIC_SEARCH_EMBED_DIMENSIONS=256

# Optional bootstrap admin account for fresh installs.
# Leave ADMIN_BOOTSTRAP_PASSWORD blank to skip creating any local admin user.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=

# ─── Google OAuth ───
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {SITE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── GitHub OAuth ───
# Create at: https://github.com/settings/developers → New OAuth App
# Authorization callback URL: {SITE_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── X (Twitter) OAuth ───
# Create at: https://developer.x.com/en/portal/projects
# Callback URL: {SITE_URL}/api/auth/twitter/callback
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
